{
  "name": "@weichen96/dsh-browser-use",
  "version": "0.3.0",
  "packageManager": "pnpm@12.5.1",
  "type": "module",
  "description": "DeepSeek Harness browser provider: read a page as an indexed action space, then run one guarded operation at a time.",
  "icon": "icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardochen1996/dsh-browser-use.git"
  },
  "homepage": "https://github.com/ricardochen1996/dsh-browser-use#readme",
  "bugs": {
    "url": "https://github.com/ricardochen1996/dsh-browser-use/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/config.js",
    "lib/jev.js",
    "lib/engine.js",
    "lib/provision.js",
    "lib/python.js",
    "lib/sessions.js",
    "lib/sidecar.js",
    "lib/tools.js",
    "lib/status.js",
    "lib/inspector.js",
    "lib/client.js",
    "bin/doctor.mjs",
    "sidecar/bridge.py",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh-CN.md",
    "docs/*.svg",
    "pyproject.toml",
    "uv.lock",
    "vendor/*.whl",
    "vendor/requirements.txt",
    "vendor/jev-ultrafast.json",
    "bench/*.py",
    "bench/fixture.html",
    "bench/results.json"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "doctor": "node bin/doctor.mjs",
    "test": "node test/plugin.mjs && node test/delegation.mjs && node test/inspector.mjs && node test/provision.mjs",
    "test:python": "uv run pytest",
    "test:e2e": "uv run python test/check_bridge.py && uv run python test/check_tabs.py",
    "check": "uv run ruff check . && uv run pytest -q && npm run release:check && node test/plugin.mjs && node test/delegation.mjs && node test/inspector.mjs && node test/provision.mjs",
    "release:check": "uv run python bin/check_release.py",
    "release:pack": "npm run release:check && node bin/check-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "browser",
    "browser-use",
    "cdp"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
